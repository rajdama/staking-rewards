# Required
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/staking?sslmode=disable
STAKING_ADDRESS=0x...

# Block the contract was deployed at (contracts/deployments/11155111.json -> startBlock)
START_BLOCK=0

# Optional
PORT=8080
POLL_INTERVAL=6s
BATCH_SIZE=2000
CONFIRMATIONS=3

# Optional keeper: resets expired lock boosts. Use a separate wallet with a little Sepolia ETH.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL=10m
