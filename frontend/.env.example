# Copy to .env.local and fill in. All values are public (they ship to the browser).

# 11155111 = Sepolia, 31337 = local Anvil
NEXT_PUBLIC_CHAIN_ID=11155111

# From contracts/deployments/<chainId>.json after deploying
NEXT_PUBLIC_STAKING_ADDRESS=

# Optional: your own RPC (e.g. Alchemy). Falls back to a public one.
NEXT_PUBLIC_RPC_URL=

# Free project ID from https://cloud.walletconnect.com (needed for mobile wallets)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: URL of the Go indexer API, e.g. https://staking-indexer.up.railway.app
NEXT_PUBLIC_INDEXER_URL=
